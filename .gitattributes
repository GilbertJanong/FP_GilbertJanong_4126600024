# Auto detect text files and perform LF normalization on checkin
* text=auto

# Source code and text files
*.py text diff=python eol=lf
*.ipynb text eol=lf
*.md text diff eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files - do not touch line endings or diff as text
*.pt binary
*.onnx binary
*.engine binary
*.torchscript binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
